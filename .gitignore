# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.cert

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# local env files (never commit real secrets or credentials)
.env
.env*.local
.env.production
.env.staging
!.env.example

# runtime & persistent data (contains real tokens, instance keys, phone numbers)
/data/*
!/data/.gitkeep

# uploaded user media (images, audios, videos, documents)
/public/uploads/*
!/public/uploads/.gitkeep
/public/uploads/media/*
!/public/uploads/media/.gitkeep

# vercel & ide
.vercel
.idea
.vscode

# typescript
*.tsbuildinfo
next-env.d.ts
